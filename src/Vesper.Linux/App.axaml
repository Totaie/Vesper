<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vesper.Linux.App"
             Name="Vesper"
             RequestedThemeVariant="Default">
    <!-- Resources first: Vesper's styles refer to them. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://vesper/Themes/Vesper.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <!-- The evening star's gold over Fluent's controls, as the Windows app overrides WinUI's accent ramp. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#F4C67A" RegionColor="#1C1C21" />
                <ColorPaletteResources x:Key="Light" Accent="#A8680A" RegionColor="#F3F3F5" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://vesper/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
