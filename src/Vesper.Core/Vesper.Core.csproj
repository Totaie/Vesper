<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The app publishes self-contained for these; restoring for them always keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>Vesper.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vesper.Core.Tests" />
    <InternalsVisibleTo Include="Vesper.FakeMac" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DevTunnels.Ssh" />
    <PackageReference Include="Microsoft.DevTunnels.Ssh.Tcp" />
  </ItemGroup>
</Project>
