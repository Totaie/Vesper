<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Vesper's look: the evening star. A warm gold accent over Windows 11's own materials, and a
        twilight sky for the Macs' artwork. Accent colours override WinUI's ramp, so every stock
        control picks them up without restyling.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#E9A23B</Color>
            <Color x:Key="SystemAccentColorLight1">#EFB458</Color>
            <Color x:Key="SystemAccentColorLight2">#F4C67A</Color>
            <Color x:Key="SystemAccentColorLight3">#F8D9A4</Color>
            <Color x:Key="SystemAccentColorDark1">#C9841F</Color>
            <Color x:Key="SystemAccentColorDark2">#A2660E</Color>
            <Color x:Key="SystemAccentColorDark3">#7B4B05</Color>

            <SolidColorBrush x:Key="VesperStarBrush" Color="#F4C67A" />
            <SolidColorBrush x:Key="VesperVerifiedBrush" Color="#5BD69B" />
            <SolidColorBrush x:Key="VesperProtectedBrush" Color="#7FB8FF" />
            <SolidColorBrush x:Key="VesperWarningBrush" Color="#F5B547" />
            <SolidColorBrush x:Key="VesperDangerBrush" Color="#FF7A7A" />
            <SolidColorBrush x:Key="VesperPillBackgroundBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="VesperCardHoverBorderBrush" Color="#55F4C67A" />
            <Color x:Key="VesperGlowColor">#3A3B4FB8</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#C77D12</Color>
            <Color x:Key="SystemAccentColorLight1">#D99436</Color>
            <Color x:Key="SystemAccentColorLight2">#E6AE5E</Color>
            <Color x:Key="SystemAccentColorLight3">#F0C98F</Color>
            <Color x:Key="SystemAccentColorDark1">#A8680A</Color>
            <Color x:Key="SystemAccentColorDark2">#8A5405</Color>
            <Color x:Key="SystemAccentColorDark3">#6B4002</Color>

            <SolidColorBrush x:Key="VesperStarBrush" Color="#C77D12" />
            <SolidColorBrush x:Key="VesperVerifiedBrush" Color="#16794A" />
            <SolidColorBrush x:Key="VesperProtectedBrush" Color="#1F5FAD" />
            <SolidColorBrush x:Key="VesperWarningBrush" Color="#9A5B00" />
            <SolidColorBrush x:Key="VesperDangerBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="VesperPillBackgroundBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="VesperCardHoverBorderBrush" Color="#66C77D12" />
            <Color x:Key="VesperGlowColor">#224A55C8</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="VesperStarBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="VesperVerifiedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="VesperProtectedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="VesperWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="VesperDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="VesperPillBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VesperCardHoverBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <Color x:Key="VesperGlowColor">#00000000</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The twilight sky behind each Mac's artwork. -->
    <LinearGradientBrush x:Key="VesperSkyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#141638" />
        <GradientStop Offset="0.5" Color="#2E2766" />
        <GradientStop Offset="0.82" Color="#764A8C" />
        <GradientStop Offset="1" Color="#D88470" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VesperScreenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1B1E4E" />
        <GradientStop Offset="0.6" Color="#5A3D8F" />
        <GradientStop Offset="1" Color="#F09A6E" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VesperAluminumBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F1F2F5" />
        <GradientStop Offset="1" Color="#B8BDC7" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VesperStarFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF6D6" />
        <GradientStop Offset="1" Color="#F2AE4A" />
    </LinearGradientBrush>

    <FontFamily x:Key="VesperDisplayFont">Sitka Display, Georgia</FontFamily>
    <FontFamily x:Key="VesperWordmarkFont">Sitka Banner, Georgia</FontFamily>

    <Style x:Key="VesperPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3,10,3" />
        <Setter Property="Background" Value="{ThemeResource VesperPillBackgroundBrush}" />
    </Style>

    <Style x:Key="VesperSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,0,0,10" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="VesperToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="VesperToolbarButtonStyleDropDown" TargetType="DropDownButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6,6,6" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="VesperToolbarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
</ResourceDictionary>
