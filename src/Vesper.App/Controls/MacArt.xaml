<UserControl
    x:Class="Vesper.Controls.MacArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- A Studio Display with a Mac Studio beside it, drawn on a 240×132 canvas. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="240" Height="132">
            <!-- Display -->
            <Rectangle Canvas.Left="22" Canvas.Top="4" Width="150" Height="92" RadiusX="6" RadiusY="6"
                       Fill="#1B1C22" Stroke="{StaticResource VesperAluminumBrush}" StrokeThickness="2" />
            <Rectangle Canvas.Left="27" Canvas.Top="9" Width="140" Height="82" RadiusX="2" RadiusY="2"
                       Fill="{StaticResource VesperScreenBrush}" />
            <!-- A tiny evening on the screen -->
            <Path Canvas.Left="128" Canvas.Top="18" Width="12" Height="12" Stretch="Uniform"
                  Fill="{StaticResource VesperStarFillBrush}"
                  Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
            <Path Canvas.Left="27" Canvas.Top="66" Width="140" Height="25" Stretch="Fill" Fill="#33100A26"
                  Data="M 0,20 C 30,6 52,14 70,10 C 92,4 110,16 140,8 L 140,25 L 0,25 Z" />
            <!-- Menu bar and dock hints -->
            <Rectangle Canvas.Left="27" Canvas.Top="9" Width="140" Height="4" Fill="#33FFFFFF" />
            <Rectangle Canvas.Left="72" Canvas.Top="82" Width="50" Height="6" RadiusX="3" RadiusY="3" Fill="#40FFFFFF" />
            <!-- Stand -->
            <Path Fill="{StaticResource VesperAluminumBrush}" Data="M 86,96 L 108,96 L 112,118 L 82,118 Z" />
            <Rectangle Canvas.Left="70" Canvas.Top="117" Width="54" Height="5" RadiusX="2.5" RadiusY="2.5"
                       Fill="{StaticResource VesperAluminumBrush}" />
            <!-- Mac Studio -->
            <Rectangle Canvas.Left="160" Canvas.Top="84" Width="74" Height="38" RadiusX="8" RadiusY="8"
                       Fill="{StaticResource VesperAluminumBrush}" />
            <Rectangle Canvas.Left="160" Canvas.Top="84" Width="74" Height="38" RadiusX="8" RadiusY="8"
                       Stroke="#33000000" StrokeThickness="0.8" />
            <Rectangle Canvas.Left="168" Canvas.Top="104" Width="3.5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#5A5F6B" />
            <Rectangle Canvas.Left="175" Canvas.Top="104" Width="3.5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#5A5F6B" />
            <Rectangle Canvas.Left="190" Canvas.Top="108" Width="18" Height="2" RadiusX="1" RadiusY="1" Fill="#6A707C" />
            <Ellipse Canvas.Left="223" Canvas.Top="110" Width="3" Height="3" Fill="#FFFFFF" />
            <Rectangle Canvas.Left="160" Canvas.Top="121" Width="74" Height="1.5" Fill="#22000000" />
        </Canvas>
    </Viewbox>
</UserControl>
