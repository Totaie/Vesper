<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Vesper</RootNamespace>
    <AssemblyName>Vesper</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Needed for an unpackaged app's resource index (.pri) and compiled XAML (.xbf) to be
         published; without them the published app can't load its own pages. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Vesper.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Vesper — a fast, secure Apple Remote Desktop client for Windows.</Description>
    <!-- No telemetry or diagnostics leave the machine: .NET's own event pipe and startup hooks are off. -->
    <EventSourceSupport>false</EventSourceSupport>
    <StartupHookSupport>false</StartupHookSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vesper.Client\Vesper.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>
  <ItemGroup>
    <!-- Licence notices for code Vesper ports, shipped beside the app. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Only what Vesper runs on is published. Its interface is English, so the Windows UI library's
    86 other languages stay out (English is also what that library falls back to). The runtime's
    debugger and crash-dump helpers stay out too: Vesper turns crash dumps off, since a dump would
    hold screen contents and session keys.
  -->
  <Target Name="VesperTrimPublishedFiles" BeforeTargets="_ComputeResolvedFilesToPublishTypes">
    <ItemGroup>
      <_VesperUnneeded Include="@(ResolvedFileToPublish)"
                       Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '(?i)^(?!en-us[\\/]|en-gb[\\/])[a-z]{2,3}(-[a-z0-9]+)*[\\/][^\\/]+\.mui$'))" />
      <_VesperUnneeded Include="@(ResolvedFileToPublish)"
                       Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)', '(?i)^(createdump\.exe|mscordbi\.dll|mscordaccore.*\.dll|Microsoft\.DiaSymReader\.Native\..*\.dll)$'))" />
      <ResolvedFileToPublish Remove="@(_VesperUnneeded)" />
    </ItemGroup>
  </Target>

</Project>
