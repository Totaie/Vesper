<ContentDialog
    x:Class="Vesper.Views.MacEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    CloseButtonText="Cancel">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0" MaxHeight="620">
        <StackPanel Spacing="16" Width="560">
            <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Vesper signs in with your Mac account, the same one you use at the Mac." />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Studio" TextChanged="Field_Changed" />
                <TextBox x:Name="HostBox" Grid.Column="1" Header="Address" PlaceholderText="studio.local or 192.168.1.20"
                         TextChanged="Field_Changed" IsSpellCheckEnabled="False" />
                <TextBox x:Name="UserBox" Grid.Row="1" Header="Mac account" PlaceholderText="Your short user name"
                         TextChanged="Field_Changed" IsSpellCheckEnabled="False" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Header="Password" PasswordRevealMode="Peek"
                             PasswordChanged="Password_Changed" />
            </Grid>
            <CheckBox x:Name="RememberBox" Content="Remember the password on this PC (encrypted)" IsChecked="True" />

            <StackPanel Spacing="8">
                <TextBlock Text="Connection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="TransportChoice" SelectionChanged="Transport_Changed" MaxColumns="1">
                    <RadioButton AutomationProperties.Name="Apple encrypted (recommended)">
                        <StackPanel>
                            <TextBlock Text="Apple encrypted (recommended)" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Signs in with the Mac's own RSA identity key, which Vesper pins on first use. The whole session is AES-encrypted. Nothing else to set up." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="Through an SSH tunnel">
                        <StackPanel>
                            <TextBlock Text="Through an SSH tunnel" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Adds a standard SSH layer with a pinned host key. Needs Remote Login turned on in the Mac's Sharing settings." />
                        </StackPanel>
                    </RadioButton>
                </RadioButtons>
                <NumberBox x:Name="SshPortBox" Header="SSH port" Value="22" Minimum="1" Maximum="65535" Width="140"
                           HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" Visibility="Collapsed" />
            </StackPanel>

            <Expander Header="Display and input" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <ComboBox x:Name="ResolutionBox" Header="Resolution" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Match this display — the Mac scales Retina down first (fastest)" />
                        <ComboBoxItem Content="Every native pixel (sharpest, most bandwidth)" />
                    </ComboBox>
                    <ComboBox x:Name="ColorBox" Header="Colour" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Full colour, lossless" />
                        <ComboBoxItem Content="Thousands of colours — about half the data" />
                        <ComboBoxItem Content="Greyscale — for very slow connections" />
                    </ComboBox>
                    <ComboBox x:Name="ModifierBox" Header="Modifier keys" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Mac style: Ctrl is ⌘ Command, Alt is ⌥ Option, Windows key is ⌃ Control" />
                        <ComboBoxItem Content="As labelled: Ctrl is ⌃ Control, Alt is ⌥ Option, Windows key is ⌘ Command" />
                    </ComboBox>
                    <ToggleSwitch x:Name="ClipboardSwitch" Header="Share the clipboard (text)" OffContent="Off — nothing crosses over"
                                  OnContent="On — only while the session window is in front" />
                    <ToggleSwitch x:Name="ViewOnlySwitch" Header="View only" OffContent="Control the Mac" OnContent="Watch without sending input" />
                </StackPanel>
            </Expander>

            <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <NumberBox x:Name="PortBox" Header="Screen Sharing port" Value="5900" Minimum="1" Maximum="65535" Width="180"
                               HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" />
                    <ComboBox x:Name="CodecBox" Header="Compression" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Automatic — zlib on the local network, ZRLE further away" />
                        <ComboBoxItem Content="zlib — least work for the Mac" />
                        <ComboBoxItem Content="ZRLE — fewest bytes on the wire" />
                    </ComboBox>
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="LegacySwitch" Header="Allow Apple's older sign-in on unprotected networks"
                                      OffContent="Off (recommended)" OnContent="On" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Only for Macs that don't offer RSA sign-in. That method is still encrypted, but someone on the same network could impersonate the Mac to capture your password. Through an SSH tunnel or a VPN like Tailscale it's always allowed, because those prove who's on the other end." />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
