<Window
    x:Class="Vesper.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vesper.Views"
    xmlns:controls="using:Vesper.Controls"
    xmlns:services="using:Vesper.Services"
    Title="Vesper">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- An evening glow at the top of the window. -->
        <Rectangle Grid.RowSpan="2" Height="420" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop x:Name="GlowTop" Offset="0" Color="{ThemeResource VesperGlowColor}" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
                <Path Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource VesperStarFillBrush}"
                      Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
                <TextBlock Text="Vesper" FontFamily="{StaticResource VesperWordmarkFont}" FontSize="17"
                           VerticalAlignment="Center" CharacterSpacing="40" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1180" Padding="44,10,44,36" Spacing="34">

                <!-- Header -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="Greeting" Text="Good evening" FontFamily="{StaticResource VesperDisplayFont}"
                                   FontSize="40" FontWeight="SemiLight" />
                        <TextBlock x:Name="Subtitle" Text="Your Macs, a click away — fast and encrypted end to end."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="AddButton" Style="{StaticResource AccentButtonStyle}" Click="AddMac_Click" Padding="14,8"
                                AutomationProperties.Name="Add a Mac">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add a Mac" />
                            </StackPanel>
                        </Button>
                        <Button Click="Settings_Click" Padding="10,8" ToolTipService.ToolTip="Settings"
                                AutomationProperties.Name="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The Macs -->
                <ItemsRepeater x:Name="MacsRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="330" MinItemHeight="318" MinRowSpacing="18" MinColumnSpacing="18"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:MacCardItem">
                            <Grid x:Name="Card" CornerRadius="12" BorderThickness="1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                  DoubleTapped="Card_DoubleTapped" Tag="{x:Bind Id}">
                                <Grid.TranslationTransition>
                                    <Vector3Transition Duration="0:0:0.15" />
                                </Grid.TranslationTransition>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="164" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Artwork -->
                                <Grid Background="{StaticResource VesperSkyBrush}">
                                    <Path Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,18,34,0" Fill="#E8FFF1D2"
                                          Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
                                    <Ellipse Width="2" Height="2" Fill="#99FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,26,0,0" />
                                    <Ellipse Width="1.5" Height="1.5" Fill="#77FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,14,0,0" />
                                    <Ellipse Width="2" Height="2" Fill="#66FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,88,0" />
                                    <controls:MacArt Height="112" Margin="0,22,0,0" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource VesperPillStyle}" Background="#33000000" Margin="12"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind ModelName}" FontSize="12" Foreground="#E6FFFFFF" />
                                    </Border>
                                </Grid>

                                <!-- Details -->
                                <Grid Grid.Row="1" Padding="18,14,14,14" RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Address}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <FontIcon Glyph="{x:Bind SecurityGlyph}" FontSize="12" Foreground="{x:Bind SecurityBrush}" />
                                        <TextBlock Text="{x:Bind SecurityText}" FontSize="12" Foreground="{x:Bind SecurityBrush}" />
                                        <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind LastConnected}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="6">
                                        <Button Padding="8,6" Background="Transparent" BorderThickness="0" Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="More" AutomationProperties.Name="More options">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Text="Edit" Tag="{x:Bind Id}" Click="Edit_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Forget saved password" Tag="{x:Bind Id}" Click="ForgetPassword_Click"
                                                                    IsEnabled="{x:Bind HasSavedPassword}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D7;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Forget trusted identity" Tag="{x:Bind Id}" Click="ForgetIdentity_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA18;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Remove" Tag="{x:Bind Id}" Click="Remove_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Style="{StaticResource AccentButtonStyle}" Padding="16,7" Tag="{x:Bind Id}" Click="Connect_Click"
                                                AutomationProperties.Name="Connect">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Connect" />
                                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- First run -->
                <Grid x:Name="EmptyState" Visibility="Collapsed" CornerRadius="14" BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Background="{StaticResource VesperSkyBrush}" CornerRadius="13,0,0,13">
                        <Path Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,30,48,0" Fill="#E8FFF1D2" Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
                        <controls:MacArt Margin="36,56,36,36" />
                    </Grid>
                    <StackPanel Grid.Column="1" Padding="36,32" Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Add your first Mac" FontFamily="{StaticResource VesperDisplayFont}" FontSize="28" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Vesper speaks Apple's own Screen Sharing protocol, so there's nothing to install on the Mac." />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <local:SetupStep Number="1" Text="On the Mac, open System Settings › General › Sharing and turn on Screen Sharing (or Remote Management)." />
                            <local:SetupStep Number="2" Text="Click ⓘ next to it and make sure your account is allowed. For an SSH tunnel, also turn on Remote Login." />
                            <local:SetupStep Number="3" Text="Add it here with its name (like studio.local) or IP address, and your Mac account." />
                        </StackPanel>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="AddMac_Click" Padding="16,8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add a Mac" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Macs found nearby -->
                <StackPanel x:Name="NearbySection" Visibility="Collapsed">
                    <TextBlock Text="On this network" Style="{StaticResource VesperSectionHeaderStyle}" />
                    <ItemsRepeater x:Name="NearbyRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="services:DiscoveredMac">
                                <Grid Padding="14,10" CornerRadius="8" ColumnSpacing="12"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Host}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Add" Tag="{x:Bind Id}" Click="AddNearby_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Promise -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Opacity="0.75" Margin="0,6,0,0">
                    <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Private by design: Vesper talks only to the Macs you add. No accounts, no telemetry, no cloud." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
