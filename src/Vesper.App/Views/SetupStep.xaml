<UserControl
    x:Class="Vesper.Views.SetupStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
            <TextBlock x:Name="NumberText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                       FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
        <TextBlock x:Name="BodyText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
    </Grid>
</UserControl>
