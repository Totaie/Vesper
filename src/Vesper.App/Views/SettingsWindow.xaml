<Window
    x:Class="Vesper.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vesper Settings">

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Grid">
                <Setter Property="Padding" Value="18,14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
            <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource VesperStarFillBrush}"
                      Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
                <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="820" Padding="36,8,36,36" Spacing="6">
                <TextBlock Text="Settings" FontFamily="{StaticResource VesperDisplayFont}" FontSize="34" Margin="0,0,0,14" />

                <TextBlock Text="Security and privacy" Style="{StaticResource VesperSectionHeaderStyle}" Margin="2,6,0,6" />
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA18;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Hide sessions from screen capture" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Session windows show up black in screenshots, screen recordings, screen sharing (Teams, Zoom) and Windows Recall, so what's on your Mac stays off other apps' records." />
                    </StackPanel>
                    <ToggleSwitch x:Name="CaptureSwitch" Grid.Column="2" Toggled="Capture_Toggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE928;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Require Windows Hello for saved passwords" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="HelloDescription" Style="{StaticResource CardDescription}"
                                   Text="Saved passwords are always encrypted to your Windows account. With Hello, they're also locked behind your face, fingerprint or PIN, so another program running as you can't read them silently." />
                    </StackPanel>
                    <ToggleSwitch x:Name="HelloSwitch" Grid.Column="2" Toggled="Hello_Toggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Lock saved passwords" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Wipe unlocked passwords from memory after this long without an open session." />
                    </StackPanel>
                    <ComboBox x:Name="LockBox" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="Lock_Changed" MinWidth="170">
                        <ComboBoxItem Content="After 5 minutes" Tag="5" />
                        <ComboBoxItem Content="After 15 minutes" Tag="15" />
                        <ComboBoxItem Content="After an hour" Tag="60" />
                        <ComboBoxItem Content="After 8 hours" Tag="480" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74D;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Forget every saved password" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Deletes the password vault from this PC. Your Macs stay; you'll be asked for passwords again." />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Forget passwords" Click="ForgetAll_Click" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Keyboard and mouse" Style="{StaticResource VesperSectionHeaderStyle}" Margin="2,18,0,6" />
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE765;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Send Alt+Tab and the Windows key to the Mac" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Like Remote Desktop. Ctrl+Alt+Home always gives them back to Windows; Ctrl+Alt+Enter toggles full screen." />
                    </StackPanel>
                    <ComboBox x:Name="ShortcutsBox" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="Shortcuts_Changed" MinWidth="170">
                        <ComboBoxItem Content="In full screen" />
                        <ComboBoxItem Content="Always" />
                        <ComboBoxItem Content="Never" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE962;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Scroll speed" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Vesper sends the Mac precise, trackpad-like scrolls." />
                    </StackPanel>
                    <Slider x:Name="ScrollSlider" Grid.Column="2" Width="170" Minimum="0.25" Maximum="3" StepFrequency="0.25"
                            VerticalAlignment="Center" ValueChanged="Scroll_Changed" />
                </Grid>

                <TextBlock Text="Appearance" Style="{StaticResource VesperSectionHeaderStyle}" Margin="2,18,0,6" />
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="Theme_Changed" MinWidth="170">
                        <ComboBoxItem Content="Use Windows setting" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Show connection statistics" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Frames per second, screen updates, bandwidth and round-trip time in the session's title bar." />
                    </StackPanel>
                    <ToggleSwitch x:Name="StatsSwitch" Grid.Column="2" Toggled="Stats_Toggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE701;" FontSize="18" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Find Macs on this network" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Listens for Macs announcing Screen Sharing on the local network. Nothing is sent anywhere." />
                    </StackPanel>
                    <ToggleSwitch x:Name="DiscoverSwitch" Grid.Column="2" Toggled="Discover_Toggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>

                <TextBlock Text="About" Style="{StaticResource VesperSectionHeaderStyle}" Margin="2,18,0,6" />
                <Grid Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Source="ms-appx:///Assets/Vesper-64.png" Width="40" Height="40" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Vesper" FontFamily="{StaticResource VesperWordmarkFont}" FontSize="20" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="Named for the evening star: Hesperus to the Greeks, whose Hesperides kept the golden apples in a guarded garden at the edge of the world. Vesper speaks Apple's own Screen Sharing protocol (RFB 003.889) with its encrypted record layer, server-side scaling and pushed updates." />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="No accounts, no telemetry, no update checks, no crash reports. Vesper connects only to the Macs you add. Its settings live in %LOCALAPPDATA%\Vesper, with passwords sealed by AES-256-GCM under a key protected by Windows." />
                        <Expander Header="Diagnostics (kept in memory only)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="300"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                <Button Content="Copy" Click="CopyDiagnostics_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
