<Window
    x:Class="Vesper.Views.SessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vesper.Views"
    xmlns:controls="using:Vesper.Controls">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the Mac, how it's secured, and the session controls. -->
        <Grid x:Name="TitleBarArea" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionSpace" Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,8,0" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource VesperStarFillBrush}"
                      Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
                <TextBlock x:Name="MacName" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="SecurityPill" Padding="9,3,11,3" CornerRadius="11" BorderThickness="0" Height="26"
                        Background="{ThemeResource VesperPillBackgroundBrush}" Visibility="Collapsed"
                        AutomationProperties.Name="Connection security">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="SecurityIcon" Glyph="&#xE72E;" FontSize="12" />
                        <TextBlock x:Name="SecurityText" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel MaxWidth="360" Spacing="10">
                                <TextBlock x:Name="SecurityFlyoutTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="SecurityFlyoutDetail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SecurityFlyoutIdentity" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- The drag region: everything not a control. -->
            <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent">
                <TextBlock x:Name="StatsText" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="11" FontFamily="Cascadia Mono, Consolas" Opacity="0.6" Visibility="Collapsed" />
            </Grid>

            <StackPanel x:Name="Toolbar" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <DropDownButton x:Name="ViewButton" Style="{StaticResource VesperToolbarButtonStyleDropDown}"
                                ToolTipService.ToolTip="Display" AutomationProperties.Name="Display options">
                    <FontIcon Glyph="&#xE7F4;" FontSize="15" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ViewMenu" Placement="BottomEdgeAlignedRight" Opening="ViewMenu_Opening">
                            <RadioMenuFlyoutItem x:Name="FitItem" Text="Fit to window" GroupName="scaling" Click="Scaling_Click" Tag="Fit" />
                            <RadioMenuFlyoutItem x:Name="ActualItem" Text="Actual size (1:1 pixels)" GroupName="scaling" Click="Scaling_Click" Tag="ActualSize" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem x:Name="MatchItem" Text="Resolution: match this display" GroupName="resolution" Click="Resolution_Click" Tag="Match" />
                            <RadioMenuFlyoutItem x:Name="NativeItem" Text="Resolution: every native pixel" GroupName="resolution" Click="Resolution_Click" Tag="Native" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem x:Name="FullColorItem" Text="Full colour" GroupName="color" Click="Color_Click" Tag="Full" />
                            <RadioMenuFlyoutItem x:Name="ThousandsItem" Text="Thousands of colours" GroupName="color" Click="Color_Click" Tag="Thousands" />
                            <RadioMenuFlyoutItem x:Name="GrayItem" Text="Greyscale" GroupName="color" Click="Color_Click" Tag="Grayscale" />
                            <MenuFlyoutSeparator x:Name="DisplaysSeparator" Visibility="Collapsed" />
                            <MenuFlyoutSubItem x:Name="DisplaysMenu" Text="Show display" Visibility="Collapsed" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <ToggleButton x:Name="ClipboardToggle" Style="{StaticResource VesperToolbarToggleStyle}" Click="Clipboard_Click"
                              ToolTipService.ToolTip="Share clipboard" AutomationProperties.Name="Share clipboard">
                    <FontIcon Glyph="&#xE77F;" FontSize="15" />
                </ToggleButton>

                <DropDownButton x:Name="KeysButton" Style="{StaticResource VesperToolbarButtonStyleDropDown}"
                                ToolTipService.ToolTip="Keyboard" AutomationProperties.Name="Keyboard">
                    <FontIcon Glyph="&#xE765;" FontSize="15" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="KeysMenu_Opening">
                            <MenuFlyoutItem Text="Spotlight  (⌘ Space)" Tag="spotlight" Click="Shortcut_Click" />
                            <MenuFlyoutItem Text="Switch apps  (⌘ Tab)" Tag="apps" Click="Shortcut_Click" />
                            <MenuFlyoutItem Text="Mission Control  (⌃ ↑)" Tag="mission" Click="Shortcut_Click" />
                            <MenuFlyoutItem Text="Force Quit…  (⌥ ⌘ Esc)" Tag="forcequit" Click="Shortcut_Click" />
                            <MenuFlyoutItem Text="Screenshot  (⇧ ⌘ 4)" Tag="screenshot" Click="Shortcut_Click" />
                            <MenuFlyoutItem Text="Lock screen  (⌃ ⌘ Q)" Tag="lock" Click="Shortcut_Click" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="MacStyleItem" Text="Ctrl is ⌘ Command (Mac style)" Click="MacStyle_Click" />
                            <ToggleMenuFlyoutItem x:Name="CaptureShortcutsItem" Text="Send Alt+Tab and the Windows key to the Mac" Click="CaptureShortcuts_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <ToggleButton x:Name="ShieldToggle" Style="{StaticResource VesperToolbarToggleStyle}" Click="Shield_Click"
                              ToolTipService.ToolTip="Hide this window from screenshots, recording and screen sharing"
                              AutomationProperties.Name="Hide from screen capture">
                    <FontIcon Glyph="&#xEA18;" FontSize="15" />
                </ToggleButton>

                <Button x:Name="FullScreenButton" Style="{StaticResource VesperToolbarButtonStyle}" Click="FullScreen_Click"
                        ToolTipService.ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen">
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="15" />
                </Button>

                <Button x:Name="DisconnectButton" Style="{StaticResource VesperToolbarButtonStyle}" Click="Disconnect_Click"
                        ToolTipService.ToolTip="Disconnect" AutomationProperties.Name="Disconnect" Margin="2,0,6,0">
                    <FontIcon Glyph="&#xE7E8;" FontSize="15" Foreground="{ThemeResource VesperDangerBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The Mac's screen -->
        <local:SessionSurface x:Name="Surface" Grid.Row="1" />

        <!-- Full-screen toolbar, revealed at the top edge -->
        <Border x:Name="FloatingBar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                Padding="12,6" CornerRadius="12" Visibility="Collapsed"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                PointerExited="FloatingBar_PointerExited">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource VesperStarFillBrush}" VerticalAlignment="Center"
                      Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
                <TextBlock x:Name="FloatingName" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <FontIcon x:Name="FloatingSecurityIcon" Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Center" />
                <Button Style="{StaticResource VesperToolbarButtonStyle}" Click="FullScreen_Click" ToolTipService.ToolTip="Leave full screen (F11)">
                    <FontIcon Glyph="&#xE73F;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource VesperToolbarButtonStyle}" Click="Disconnect_Click" ToolTipService.ToolTip="Disconnect">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="{ThemeResource VesperDangerBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Connecting / problems -->
        <Grid x:Name="Overlay" Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.Transitions>
                <TransitionCollection>
                    <ContentThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="170" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Background="{StaticResource VesperSkyBrush}" CornerRadius="15,15,0,0">
                    <Path Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,22,40,0" Fill="#E8FFF1D2" Data="M 50,0 Q 56,44 100,50 Q 56,56 50,100 Q 44,56 0,50 Q 44,44 50,0 Z" />
                    <controls:MacArt Height="118" Margin="0,24,0,0" />
                </Grid>
                <StackPanel Grid.Row="1" Padding="28,22,28,24" Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="OverlayTitle" FontFamily="{StaticResource VesperDisplayFont}" FontSize="26" TextWrapping="Wrap" />
                        <TextBlock x:Name="OverlayMessage" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    </StackPanel>
                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:StepItem">
                                <Grid ColumnSpacing="12" Opacity="{x:Bind Opacity, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsActive, Mode=OneWay}"
                                                  Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource VesperVerifiedBrush}"
                                              Visibility="{x:Bind DoneVisibility, Mode=OneWay}" />
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                             Visibility="{x:Bind PendingVisibility, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="OverlayButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource AccentButtonStyle}" Click="Retry_Click" Visibility="Collapsed" />
                        <Button x:Name="EditButton" Content="Edit Mac" Click="EditMac_Click" Visibility="Collapsed" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="Disconnect_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Quiet notices -->
        <InfoBar x:Name="Notice" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                 IsClosable="True" IsOpen="False" MaxWidth="560" />
    </Grid>
</Window>
