<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in for macOS Screen Sharing, for testing Vesper without a Mac. Development only:
       it listens on loopback, and its "Mac" credentials are whatever you pass on the command line. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vesper.FakeMac</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vesper.Core\Vesper.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
</Project>
