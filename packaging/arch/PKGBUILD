# Vesper for Arch Linux. packaging/arch/build.sh fills in pkgver and the checksums, and puts the
# self-contained build beside this file as vesper-$pkgver-linux-x64.tar.gz.
pkgname=vesper
pkgver=0.0.0
pkgrel=1
pkgdesc='Fast, encrypted Apple Remote Desktop (macOS Screen Sharing) client'
arch=('x86_64')
url='https://github.com/Totaie/Vesper'
license=('MIT')
depends=('glibc' 'gcc-libs' 'icu' 'openssl' 'zlib' 'fontconfig' 'freetype2'
         'libx11' 'libice' 'libsm' 'libxrandr' 'libxi' 'libxcursor' 'libxext' 'ca-certificates')
optdepends=('libsecret: remember Mac passwords in your login keyring'
            'gnome-keyring: a login keyring for libsecret (on KDE, kwallet does the same)'
            'polkit: install Vesper updates from inside the app')
options=('!strip' '!debug')
source=("vesper-$pkgver-linux-x64.tar.gz" 'vesper.desktop')
sha256sums=('SKIP' 'SKIP')

package() {
    install -dm755 "$pkgdir/usr/lib/vesper"
    cp -a --no-preserve=ownership vesper/. "$pkgdir/usr/lib/vesper/"
    chmod 755 "$pkgdir/usr/lib/vesper/vesper"
    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/lib/vesper/vesper "$pkgdir/usr/bin/vesper"
    install -Dm644 vesper.desktop "$pkgdir/usr/share/applications/vesper.desktop"
    install -Dm644 vesper/vesper.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/vesper.png"
    install -Dm644 vesper/THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/vesper/THIRD-PARTY-NOTICES.md"
    install -Dm644 vesper/LICENSE "$pkgdir/usr/share/licenses/vesper/LICENSE"
}
